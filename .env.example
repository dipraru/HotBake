# Copy this file to .env and adjust values for your machine.
# Use SPRING_PROFILES_ACTIVE=local to run without PostgreSQL (H2 fallback).
POSTGRES_DB=hotbake
POSTGRES_USER=hotbake_user
POSTGRES_PASSWORD=hotbake_pass
SPRING_PROFILES_ACTIVE=default

# Only needed for local (non-Docker) run with custom DB
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotbake
# SPRING_DATASOURCE_USERNAME=hotbake_user
# SPRING_DATASOURCE_PASSWORD=hotbake_pass
